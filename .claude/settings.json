{
  "permissions": {
    "allow": ["Bash(npm test:*)", "Bash(npm run typecheck:*)", "Bash(npm run build:ext:*)", "Bash(npx vitest:*)", "Bash(npx tsc:*)"],
    "deny": ["Read(~/.config/redmine-mcp/**)", "Read(./.env*)", "Edit(~/.config/redmine-mcp/**)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh" }] }
    ]
  }
}
