{
  "name": "redmine-mcp",
  "private": true,
  "type": "module",
  "workspaces": [
    "daemon",
    "extension"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ext": "node extension/build.mjs",
    "daemon": "tsx daemon/src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build:ext"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.0.0"
  },
  "version": "0.2.0"
}
