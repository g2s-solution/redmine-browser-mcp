{
  "manifest_version": 3,
  "name": "Redmine Bridge",
  "version": "0.2.0",
  "description": "Lets a local MCP daemon call Redmine with your logged-in browser session.",
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": { "default_title": "Redmine Bridge", "default_popup": "popup.html" }
}
